# Automatic HTTPS via Let's Encrypt. Set DOMAIN and optional ACME_EMAIL in deploy/.env.production.
# Caddy forwards /health, /docs, REST chat, marketplace, WhatsApp, and Telegram routes to the app.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000 {
		flush_interval -1
		transport http {
			read_timeout 5m
			write_timeout 5m
			dial_timeout 30s
		}
	}

	request_body {
		max_size 12MB
	}
}
