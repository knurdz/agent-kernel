# Copy to deploy/.env.production on the VPS (mode 600). Never commit the real file.
# deploy/deploy-vps.sh can create this interactively on first run.
#
# Required for production:
#   DOMAIN, POSTGRES_*, AK_MARKETPLACE__JWT_SECRET (>=32 chars),
#   one LLM provider key, WhatsApp + Telegram credentials.

# ---- Public HTTPS ----
DOMAIN=agripilot.example.com
ACME_EMAIL=ops@example.com

# ---- Git bootstrap (only when cloning fresh via deploy-vps.sh) ----
# REPO_URL=https://github.com/your-org/agent-kernel.git
# BRANCH=main
# INSTALL_DIR=/opt/agripilot

# ---- Postgres (internal Docker network only) ----
POSTGRES_USER=agripilot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=agripilot

# ---- Marketplace auth ----
AK_MARKETPLACE__JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_AT_LEAST_32_CHARS
AK_MARKETPLACE__JWT_EXPIRY_HOURS=24

# ---- LLM provider (set at least one) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# AGRIPILOT_MODEL_PROVIDER=openai

# ---- WhatsApp Cloud API ----
AK_WHATSAPP__VERIFY_TOKEN=CHANGE_ME_WHATSAPP_VERIFY_TOKEN
AK_WHATSAPP__ACCESS_TOKEN=
AK_WHATSAPP__PHONE_NUMBER_ID=
# Recommended in production:
# AK_WHATSAPP__APP_SECRET=

# ---- Telegram Bot API ----
AK_TELEGRAM__BOT_TOKEN=
AK_TELEGRAM__WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET

# ---- Channel metadata (shown in mobile app; no secrets) ----
AK_CHANNELS__TELEGRAM_BOT_USERNAME=your_bot
AK_CHANNELS__WHATSAPP_DISPLAY_NUMBER=+15551234567
AK_CHANNELS__WHATSAPP_WA_ME=https://wa.me/15551234567
AK_CHANNELS__TELEGRAM_LINK_TTL_MINUTES=15

# ---- Optional guardrails ----
# AK_GUARDRAIL__INPUT__ENABLED=true
# AK_GUARDRAIL__OUTPUT__ENABLED=true

# ---- Optional FCM push ----
# AK_NOTIFICATIONS__FCM_ENABLED=true
# Mount the credentials file read-only in compose when enabled:
# AK_NOTIFICATIONS__FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json

# ---- Tool limits (defaults are production-safe) ----
# AGRIPILOT_TOOL_MAX_CALLS=8
# AGRIPILOT_TOOL_TIMEOUT_SECONDS=180

# Never enable in production:
# AK_MARKETPLACE__SKIP_SUBSCRIPTION_CHECK=1
