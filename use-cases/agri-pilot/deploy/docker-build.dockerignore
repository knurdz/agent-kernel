# Duplicate of the repo-root /.dockerignore (Docker reads .dockerignore from the build context root only).
# Older Docker Compose versions do not support build.ignore — keep both files in sync.

.git/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.claude/
**/.agents/
**/node_modules/
docs/
e2e/
ak-deployment/
examples/
ak-py/tests/
use-cases/README.md
use-cases/waste-sorting-assistant/
use-cases/*/mobile/
use-cases/agri-pilot/tests/
use-cases/agri-pilot/PLAN.md
use-cases/agri-pilot/plan/
use-cases/agri-pilot/README.md
use-cases/agri-pilot/data/chroma_db/
use-cases/agri-pilot/data/app.db*
use-cases/agri-pilot/deploy/backups/
use-cases/agri-pilot/deploy/.deploy-state/
use-cases/agri-pilot/deploy/.env.production
use-cases/agri-pilot/.env.local
