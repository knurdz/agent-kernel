<?xml version="1.0" encoding="utf-8"?>
<!-- Release/default: HTTPS only (production VPS). Debug builds overlay debug/res/xml/ for local HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
