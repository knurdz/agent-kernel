# Copy to .env.local and fill in the key for whichever provider you use.
# If both are set, OpenAI is preferred unless AGRIPILOT_MODEL_PROVIDER is set.

OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider instead of auto-detecting from the keys above.
# Values: openai | gemini
AGRIPILOT_MODEL_PROVIDER=

# Optional: override the default model name per provider.
AGRIPILOT_OPENAI_MODEL=
AGRIPILOT_GEMINI_MODEL=

# Set to false to disable OpenAI guardrails entirely (no API cost).
# These override the guardrail.enabled flags in config.yaml.
AK_GUARDRAIL__INPUT__ENABLED=true
AK_GUARDRAIL__OUTPUT__ENABLED=true
