# Copy to .env.local and fill in the key for whichever provider you use.
# Precedence when several are set: OpenAI, then Gemini, then OpenRouter —
# unless AGRIPILOT_MODEL_PROVIDER is set.

OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: force a provider instead of auto-detecting from the keys above.
# Values: openai | gemini | openrouter
AGRIPILOT_MODEL_PROVIDER=

# Optional: override the default model name per provider.
AGRIPILOT_OPENAI_MODEL=
AGRIPILOT_GEMINI_MODEL=
AGRIPILOT_OPENROUTER_MODEL=

# Optional: narration-judge model (supervisor backstop). Falls back to the
# same provider selection as above when unset. Judge failures fail open.
# Values: openai | gemini | openrouter
AGRIPILOT_JUDGE_PROVIDER=
# Optional: override the judge's model name for its selected provider.
AGRIPILOT_JUDGE_MODEL=

# Set to false to disable OpenAI guardrails entirely (no API cost).
# These override the guardrail.enabled flags in config.yaml.
AK_GUARDRAIL__INPUT__ENABLED=true
AK_GUARDRAIL__OUTPUT__ENABLED=true

# ---- WhatsApp Cloud API (required to run app.py) ----
# Startup fails fast unless ACCESS_TOKEN, PHONE_NUMBER_ID and VERIFY_TOKEN are
# all set. VERIFY_TOKEN defaults to config.yaml's whatsapp.verify_token; the
# env var overrides it. APP_SECRET enables X-Hub-Signature-256 verification.
# See README.md "Local WhatsApp testing" for Meta console setup steps.
AK_WHATSAPP__VERIFY_TOKEN=
AK_WHATSAPP__ACCESS_TOKEN=
AK_WHATSAPP__PHONE_NUMBER_ID=
AK_WHATSAPP__APP_SECRET=

# ---- Telegram Bot API ----
# Token from @BotFather (/newbot or /mybots -> API Token). WEBHOOK_SECRET is
# any random string you choose; Telegram echoes it back on every request as
# X-Telegram-Bot-Api-Secret-Token and app.py rejects mismatches with 403.
# Register the webhook once (webhook and getUpdates polling are exclusive):
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/telegram/webhook&secret_token=<WEBHOOK_SECRET>
# See README.md "API / Telegram" for farmer linking + gate behavior.
AK_TELEGRAM__BOT_TOKEN=
AK_TELEGRAM__WEBHOOK_SECRET=

# ---- weather (Open-Meteo) ----
# No API key needed: Open-Meteo is free for non-commercial use
# (10k requests/day, 5k/hour, 600/minute). Weather data by Open-Meteo.com.

# Minutes a freshly fetched forecast is re-served from the short-TTL cache
# before hitting the API again (default 60; set 0 to always fetch live).
AGRIPILOT_WEATHER_CACHE_TTL_MINUTES=

# ---- debug switches (all optional; used for manual CLI testing) ----

# Force named tools to fail on every call (comma-separated), so the retry
# limit and limitation message can be observed. E.g.:
#   AGRIPILOT_DEBUG_FORCE_TOOL_FAILURE=get_forecast
AGRIPILOT_DEBUG_FORCE_TOOL_FAILURE=

# Artificial delay (seconds) before every guarded tool call, making
# parallel vs serial execution visible in the timing logs.
AGRIPILOT_DEBUG_TOOL_DELAY_SECONDS=

# Make repeated weather fetches drift apart, exercising the conflicting-
# readings path (set to 1 to enable).
AGRIPILOT_DEBUG_WEATHER_CONFLICT=

# Force check_image_quality to fail with the given reason regardless of
# the actual image: blurry | dark | no_plant.
AGRIPILOT_DEBUG_IMAGE_QUALITY_FAIL=

# Per-session cap on calls to each guarded tool before it reports a
# limitation message (default 8).
AGRIPILOT_TOOL_MAX_CALLS=8

# Timeout in seconds for a single guarded tool call (default 180).
AGRIPILOT_TOOL_TIMEOUT_SECONDS=180

# Max handoffs to the same specialist within one supervisor turn before
# routing is declared a loop (default 3).
AGRIPILOT_HANDOFF_LIMIT=3

# ---- durable session + attachment storage (Phase 7.1) ----
# config.yaml defaults keep bare-metal dev on in-memory stores; docker-compose
# sets these AK_ overrides to point both at the `redis` service automatically.
# Bare-metal Redis runs: `docker compose up -d redis`, then uncomment:
# AK_SESSION__TYPE=redis
# AK_SESSION__REDIS__URL=redis://localhost:6379
# AK_MULTIMODAL__STORAGE_TYPE=redis
# AK_MULTIMODAL__REDIS__URL=redis://localhost:6379

# ---- marketplace Postgres ----
# Schema is applied by Alembic: `uv run python -m alembic upgrade head`
# (app.py runs migrations automatically at startup).
# Docker compose wires this to the `db` service automatically.
AK_MARKETPLACE__DATABASE_URL=postgresql+psycopg://agripilot:agripilot@localhost:5432/agripilot
AK_MARKETPLACE__JWT_SECRET=
AK_MARKETPLACE__JWT_EXPIRY_HOURS=24
AK_MARKETPLACE__SIGNUP_URL=http://localhost:8000/docs

# Postgres credentials used by docker-compose's `db` service
# (bare-metal runs only need the URL above).
POSTGRES_USER=agripilot
POSTGRES_PASSWORD=agripilot
POSTGRES_DB=agripilot

# Dev-only: bypass farmer subscription gate on REST (never in prod)
# AK_MARKETPLACE__SKIP_SUBSCRIPTION_CHECK=

# Optional seed for admin
AK_MARKETPLACE__ADMIN_PHONE=
AK_MARKETPLACE__ADMIN_PASSWORD=

# ---- Mobile / channels (public metadata only; no webhook secrets in app) ----
AK_CHANNELS__TELEGRAM_BOT_USERNAME=agripilot_bot
AK_CHANNELS__WHATSAPP_DISPLAY_NUMBER=+15551234567
AK_CHANNELS__WHATSAPP_WA_ME=https://wa.me/15551234567
AK_CHANNELS__TELEGRAM_LINK_TTL_MINUTES=15

# ---- Push notifications (FCM) ----
AK_NOTIFICATIONS__FCM_ENABLED=false
AK_NOTIFICATIONS__FIREBASE_CREDENTIALS_PATH=

# ---- Rider delivery (OpenStreetMap + OSRM; no API keys) ----
AK_DELIVERY__DISPATCH_RADIUS_KM=25
# Optional: self-hosted or alternate OSRM endpoint
# AK_DELIVERY__OSRM_BASE_URL=https://router.project-osrm.org

# Redis-backed threads/sessions in Docker (see docker-compose.yml)
# AK_THREAD__TYPE=redis
# AK_THREAD__REDIS__URL=redis://localhost:6379
